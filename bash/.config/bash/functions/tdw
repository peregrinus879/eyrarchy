# Create or resume a Dev Workspace: one tmux session per project holding
# Omarchy's dev layout in one window named after the project: the AI agent on
# the left at full height, $EDITOR on the right over a shell on the bottom 15%
# of that column (50/50 by width). Focus lands on the agent.
# Usage: tdw <cc|cx|oc> [-c]   cc = Claude Code, cx = Codex, oc = OpenCode;
# -c continues the agent's last conversation in this project. Bare tdw
# re-attaches an existing project session. One agent per workspace by design
# (single writer). The agents run plain, as EyrAgents configures them.
tdw() {
  local agent="" continue_flag=0 arg
  for arg in "$@"; do
    case "$arg" in
      cc | cx | oc)
        if [[ -n $agent ]]; then
          echo "tdw: choose one agent, cc, cx, or oc"
          return 1
        fi
        agent=$arg
        ;;
      -c) continue_flag=1 ;;
      *) echo "Usage: tdw <cc|cx|oc> [-c]"; return 1 ;;
    esac
  done

  local root session existing_root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$(pwd -P)
  # Replace dots/colons, which tmux disallows in session names
  session=$(basename "$root" | tr '.:' '--')

  if tmux has-session -t "=$session" 2>/dev/null; then
    existing_root=$(tmux show-option -t "$session" -qv @dw_root)
    if [[ -n $existing_root && $existing_root != "$root" ]]; then
      echo "tmux session '$session' belongs to $existing_root; kill it or attach manually."
      return 1
    fi
    [[ -n $agent || $continue_flag == 1 ]] && echo "tdw: session exists, arguments ignored"
  else
    if [[ -z $agent ]]; then
      echo "Usage: tdw <cc|cx|oc> [-c]"
      return 1
    fi
    local binary command
    case "$agent" in
      cc) binary=claude; command=claude; ((continue_flag)) && command="claude -c" ;;
      cx) binary=codex; command=codex; ((continue_flag)) && command="codex resume --last" ;;
      oc) binary=opencode; command=opencode; ((continue_flag)) && command="opencode -c" ;;
    esac
    if ! type -P "$binary" > /dev/null 2>&1; then
      echo "tdw: required agent '$binary' is not installed"
      return 1
    fi
    # Create the window at the terminal's size: tmux hands a later resize out
    # equally across the stacked rows, which would grow the shell past 15%
    local size lines="" cols="" agent_pane editor_pane
    local -a size_args=()
    if size=$({ stty size < /dev/tty; } 2>/dev/null) && [[ $size =~ ^[0-9]+\ [0-9]+$ ]]; then
      read -r lines cols <<<"$size"
    else
      lines=${LINES:-} cols=${COLUMNS:-}
    fi
    [[ -n $lines && -n $cols && $lines -gt 0 && $cols -gt 0 ]] && size_args=(-x "$cols" -y "$lines")
    agent_pane=$(tmux new-session -d -s "$session" -c "$root" -n "$(basename "$root")" "${size_args[@]}" -P -F '#{pane_id}')
    tmux set-option -t "$session" @dw_root "$root"
    # The agent keeps the left half at full height; the editor takes the right half, with the shell on its bottom 15%
    editor_pane=$(tmux split-window -h -l 50% -t "$agent_pane" -c "$root" -P -F '#{pane_id}')
    tmux split-window -v -l 15% -t "$editor_pane" -c "$root"
    tmux send-keys -t "$agent_pane" "$command" C-m
    tmux send-keys -t "$editor_pane" "${EDITOR:-nvim} ." C-m
    tmux select-pane -t "$agent_pane"
  fi

  if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}
